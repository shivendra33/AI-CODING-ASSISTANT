APP_NAME="AI Coding Assistant"
ENVIRONMENT=development

# Use PostgreSQL for production/final deployments.
# Example: postgresql+psycopg://postgres:postgres@localhost:5432/ai_coding_assistant
DATABASE_URL=sqlite:///./ai_coding_assistant.db

JWT_SECRET_KEY=replace-this-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_REQUESTS=80
RATE_LIMIT_WINDOW_SECONDS=60

AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DEMO_MODE=true

